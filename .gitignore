# --- Gradle / Kotlin build output --------------------------------------------
.gradle/
build/
/captures
.externalNativeBuild
.cxx
.kotlin/
# IDE-compiled output (VS Code / Eclipse Java tooling writes `bin/` per module)
bin/
out/

# --- Python (tools/fonts and comparison scripts) ---------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# --- IDE and OS ----------------------------------------------------------------
*.iml
/.idea
/.run
.vscode/
.fleet/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# --- Machine-local configuration -----------------------------------------------
# sdk.dir (the Android SDK location) is written here by Android Studio.
local.properties

# Claude Code: its instruction file and per-machine settings stay on the maintainer's machine.
CLAUDE.md
.claude/

# --- Secrets and signing -------------------------------------------------------
# Provider API keys never touch the repo: they live in SecureKeyStore on the device.
*.jks
*.keystore
keystore.properties
signing.properties
google-services.json
*.env
.env*

# --- Build artifacts -------------------------------------------------------------
*.apk
*.aab
*.aar
/release
lint-results*.html
lint-results*.xml
/reports

# --- Profiling, logs and debug dumps ---------------------------------------------
*.hprof
*.trace
*.log
/perf-*.json
debug-dump/

# --- Models ------------------------------------------------------------------------
# The comic text detector and the PP-OCRv6 tiny detector under core/ocr/src/main/assets/
# ship with the app and ARE committed. Everything else is downloaded at runtime
# (LiteRT-LM translators, manga-ocr, LaMa) or is training/conversion scratch, and stays out.
/models/
/training/
*.pt
*.pth
*.task
*.litertlm
*.onnx.fp32

# --- Raw screen recordings (too large for GitHub; edited versions are committed) ---
# A phone's own recordings (`screen-<date>-…mp4`, 100 MB and more, with sound) stay out wherever they are put;
# only the edited, silent, small cut beside them is committed.
docs/ScreenRecordings/raw/
docs/ScreenRecordings/screen-*.mp4
docs/Screenshots/screen-*.*
# A phone's full-size screenshots (`Screenshot_<date>_….png`, ~2 MB each), wherever they are dropped under
# docs/Screenshots/: only the cut-down JPEGs the README uses are committed.
docs/Screenshots/**/Screenshot_*

# --- Test material ---------------------------------------------------------------
# Comics used to test on this machine, never published from here: commercial manga (copyrighted) and openly
# licensed ones (Pepper&Carrot, CC BY 4.0) alike — keep test chapters out of the repository either way.
docs/TestAssests/

# JVM crash logs
hs_err_pid*.log

# Personal notes that stay on this machine
*.local.md
